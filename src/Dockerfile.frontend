# ─────────────────────────────────────────
# Stage 1: Builder – build Vue/Vite app
# ─────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
# Cài ALL deps (gồm vite, @vitejs/plugin-vue) để build
RUN npm ci

COPY index.html      ./
COPY vite.config.js  ./
COPY src/            ./src/
COPY public/         ./public/

RUN npm run build


# ─────────────────────────────────────────
# Stage 2: Serve – Nginx Alpine phục vụ file tĩnh
# ─────────────────────────────────────────
FROM nginx:stable-alpine AS runner

# Xóa config mặc định của nginx
RUN rm /etc/nginx/conf.d/default.conf

# Copy nginx config tùy chỉnh (hỗ trợ Vue Router history mode + proxy API)
COPY nginx.conf /etc/nginx/conf.d/app.conf

# Copy bundle từ stage builder
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
